pipeline {
    agent any
  environment {
    // SEMGREP_BASELINE_REF = ""

        SEMGREP_APP_TOKEN = credentials('SEMGREP_APP_TOKEN')
        SEMGREP_PR_ID = "${env.CHANGE_ID}"

      //  SEMGREP_TIMEOUT = "300"
    }
     stages {
        stage('Semgrep-Scan') {
          steps {
             sh 'semgrep ci'
          }
        }
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh './mvnw clean install'
            }
        }

        stage('Semgrep Scan') {
            steps {
              dir('WebGoat') {
                sh '/var/jenkins_home/semgrep-venv/bin/semgrep ci'
              }
            }
        }
    }
}
